# Use em produção se quiser fixar o domínio público do app.
# Exemplo: https://sales.kynovra.com
# Em desenvolvimento pode ficar vazio para usar localhost/rede local automaticamente.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secrets abaixo pertencem ao runtime do Supabase/Edge Functions.
# Configure com `supabase secrets set ...`; não use no bundle público do Next.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

RESEND_API_KEY=
EMAIL_FROM="Kynovra Sales <onboarding@resend.dev>"
SENTRY_DSN=

# Credencial server-side do Vercel AI Gateway usada pelas Supabase Edge Functions.
# Crie uma chave com acesso ao AI Gateway no time correto e configure com:
# `pnpm exec supabase secrets set AI_GATEWAY_API_KEY=...`
# VERCEL_OIDC_TOKEN não deve ser usado no Supabase hospedado: ele expira e só é
# renovado automaticamente no runtime da Vercel.
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
