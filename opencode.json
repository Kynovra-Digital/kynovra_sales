{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "default_agent": "build",
  "instructions": [
    "AGENTS.md",
    ".opencode/project-rules.md"
  ],
  "skills": {
    "paths": [],
    "urls": []
  },
  "agent": {
    "build": {
      "model": "hcnsec/glm-5.2",
      "mode": "primary",
      "steps": 80,
      "description": "Primary coding agent for Kynovra Sales (Next.js 16 + Supabase)"
    },
    "plan": {
      "model": "hcnsec/glm-5.2",
      "mode": "subagent",
      "steps": 40,
      "description": "Planning agent. Read-only planning before implementation."
    }
  },
  "provider": {
    "hcnsec": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "HCNSEC",
      "options": {
        "baseURL": "https://api.hcnsec.cn/v1"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM-5.2",
          "tool_call": true,
          "temperature": true,
          "attachment": true,
          "limit": {
            "context": 128000,
            "output": 16384
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1"
      },
      "models": {
        "z-ai/glm-5.2-free": {
          "name": "GLM-5.2",
          "tool_call": true,
          "temperature": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "mcp": {
    "nextjs-devtools": {
      "type": "local",
      "command": [
        "/home/victorsouza/.nvm/versions/node/v24.14.1/bin/node",
        "/home/victorsouza/.nvm/versions/node/v24.14.1/lib/node_modules/npm/bin/npx-cli.js",
        "-y",
        "next-devtools-mcp"
      ],
      "environment": {
        "PATH": "/home/victorsouza/.nvm/versions/node/v24.14.1/bin:/home/victorsouza/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": [
        "/home/victorsouza/.nvm/versions/node/v24.14.1/bin/node",
        "/home/victorsouza/.nvm/versions/node/v24.14.1/lib/node_modules/npm/bin/npx-cli.js",
        "-y",
        "@playwright/mcp@latest"
      ],
      "environment": {
        "PATH": "/home/victorsouza/.nvm/versions/node/v24.14.1/bin:/home/victorsouza/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      },
      "enabled": true,
      "timeout": 30000
    },
    "docker": {
      "type": "local",
      "command": [
        "/home/victorsouza/.nvm/versions/node/v24.14.1/bin/node",
        "/home/victorsouza/.nvm/versions/node/v24.14.1/lib/node_modules/npm/bin/npx-cli.js",
        "-y",
        "@hypnosis/docker-mcp-server"
      ],
      "environment": {
        "PATH": "/home/victorsouza/.nvm/versions/node/v24.14.1/bin:/home/victorsouza/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "DOCKER_MCP_AUTO_DISCOVER": "true",
        "DOCKER_MCP_MASK_SECRETS": "true"
      },
      "enabled": true,
      "timeout": 30000
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "timeout": 30000
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true,
      "timeout": 30000
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": true,
      "timeout": 30000
    }
  }
}
