{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama-github/qwen2.5-coder:3b",
  "small_model": "ollama-github/qwen2.5-coder:3b",
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "ollama-github": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama GitHub Runner",
      "options": {
        "baseURL": "https://package-refers-pounds-damages.trycloudflare.com/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder:3b": {
          "name": "Qwen 2.5 Coder 3B",
          "limit": {
            "context": 2048,
            "output": 256
          }
        }
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "ask",
      "git status": "allow",
      "git diff": "allow",
      "npm *": "ask",
      "pnpm *": "ask",
      "npx *": "ask",
      "rm -rf *": "deny",
      "sudo *": "deny"
    }
  }
}
